PORT=4000
NODE_ENV=development

# Firebase Admin SDK Credentials
# Puede ser la ruta al archivo JSON de servicio o credenciales inline
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json
# FIREBASE_PROJECT_ID=mi-proyecto-pos

# DIAN Environment (1: Producción, 2: Habilitación / Pruebas)
DIAN_ENVIRONMENT=2

